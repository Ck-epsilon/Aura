{
  "name": "aura-tools",
  "version": "0.6.1",
  "description": "Aura read/edit tools — one package, two ways in: install it as a DeepSeek Harness bundle (aura_read / aura_edit), or run the standalone `aura` CLI / MCP server from Codex, Claude Code, Cursor or any other agent. Symbol-aware reading, intent-addressed byte-exact editing, stale-region gate, read-back verification.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "aura": "./bin/aura.mjs",
    "aura-mcp": "./bin/aura-mcp.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "mcp",
    "read",
    "edit",
    "codex"
  ],
  "files": [
    "aura-read/",
    "aura-edit/",
    "locator-lab/",
    "bin/",
    "lib/",
    "test/",
    "install.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
