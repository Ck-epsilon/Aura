{
  "openapi": "3.1.0",
  "info": {
    "title": "AuraArgus HTTP API",
    "version": "2.3.0",
    "description": "Local, keyless retrieval over primary sources (registry + default/user site packs). Returns evidence passages with source URLs and origins. Bind to 127.0.0.1 by default; set a bearer token when exposing the server."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [
    {},
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "aura_argus_health",
        "summary": "Health and version",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/sources": {
      "get": {
        "operationId": "aura_argus_sources",
        "summary": "Registered entities and sources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sources"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "aura_argus_search_get",
        "summary": "Search one question",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxSources",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 3
            }
          },
          {
            "name": "fallback",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Opt in to the 360/Sogou web fallback (weaker, anti-bot sensitive)."
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Restrict to one domain; fetch its sitemap/body as evidence."
          },
          {
            "name": "sites",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Set sites=0 to ignore default/user site packs and use only registry.json."
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence bundle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "502": {
            "description": "All registered sources failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "aura_argus_search",
        "summary": "Search one question",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evidence bundle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "502": {
            "description": "All registered sources failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          }
        }
      }
    },
    "/search/batch": {
      "post": {
        "operationId": "aura_argus_search_batch",
        "summary": "Search up to 50 questions with bounded concurrency",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-question results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/fetch": {
      "get": {
        "operationId": "aura_argus_fetch_get",
        "summary": "Fetch one URL as Markdown",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "maxChars",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 200000,
              "default": 20000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FetchResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      },
      "post": {
        "operationId": "aura_argus_fetch",
        "summary": "Fetch one URL as Markdown",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FetchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FetchResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when the server was started with --token."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadGateway": {
        "description": "Upstream retrieval failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "ok",
          "name",
          "version",
          "coverageVersion",
          "entities",
          "sources"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "coverageVersion": {
            "type": "string"
          },
          "entities": {
            "type": "integer"
          },
          "sources": {
            "type": "integer"
          },
          "uptimeMs": {
            "type": "integer"
          }
        }
      },
      "Sources": {
        "type": "object",
        "required": [
          "ok",
          "version",
          "coverageVersion",
          "entities"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "coverageVersion": {
            "type": "string"
          },
          "sites": {
            "type": "object",
            "properties": {
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "user": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "maxSources": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "default": 3
          },
          "multi": {
            "type": "boolean",
            "description": "Route comparative questions to multiple entities (default: auto)."
          },
          "followLinks": {
            "type": "boolean",
            "default": true,
            "description": "Follow one same-host documentation link when key facets are missing."
          },
          "maxFollowLinks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          },
          "fast": {
            "type": "boolean",
            "description": "Use the local section index for fact-lookup questions; open how-to/comparison questions still use live retrieval."
          },
          "docVersion": {
            "type": "string",
            "description": "Prefer versioned docs for entities with a version map, e.g. 20, 3.11, 8.0, 16."
          },
          "decompose": {
            "type": "boolean",
            "description": "Split compound questions into clauses and merge evidence with clause provenance."
          },
          "mode": {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "deep"
            ],
            "description": "Preset: fast=2 sources/no link following/index; balanced=defaults; deep=6 sources/2 followed links/decompose/no early stop."
          },
          "fallback": {
            "description": "CLI/MCP/HTTP default auto: official evidence first, web fallback only when official evidence is empty, low-confidence, or a critical facet is missing. Set false to disable.",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "auto"
                ]
              }
            ],
            "default": "auto"
          },
          "cache": {
            "type": "boolean",
            "default": true
          },
          "site": {
            "type": "string",
            "description": "Restrict to one domain."
          },
          "sites": {
            "type": "boolean",
            "default": true,
            "description": "Set false to ignore default/user site packs."
          },
          "budgetMs": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Wall-clock budget; returns partial:true with gathered evidence when exhausted."
          },
          "deepIndex": {
            "type": "boolean",
            "description": "Use a deep local index built with aura-argus index --deep."
          }
        }
      },
      "BatchRequest": {
        "type": "object",
        "required": [
          "questions"
        ],
        "properties": {
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 3
          },
          "maxSources": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "default": 3
          },
          "multi": {
            "type": "boolean",
            "description": "Route comparative questions to multiple entities (default: auto when 2+ entities and a comparison signal are present)."
          },
          "followLinks": {
            "type": "boolean",
            "default": true,
            "description": "Follow one same-host documentation link when key facets are missing."
          },
          "maxFollowLinks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          },
          "fast": {
            "type": "boolean",
            "description": "Use the local section index for fact-lookup questions; open how-to/comparison questions still use live retrieval."
          },
          "docVersion": {
            "type": "string",
            "description": "Prefer versioned docs for entities with a version map, e.g. 20, 3.11, 8.0, 16."
          },
          "decompose": {
            "type": "boolean",
            "description": "Split compound questions into clauses and merge evidence with clause provenance."
          },
          "mode": {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "deep"
            ],
            "description": "Preset: fast=2 sources/no link following/index; balanced=defaults; deep=6 sources/2 followed links/decompose/no early stop."
          },
          "fallback": {
            "description": "CLI/MCP/HTTP default auto: official evidence first, web fallback only when official evidence is empty, low-confidence, or a critical facet is missing. Set false to disable.",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "auto"
                ]
              }
            ],
            "default": "auto"
          },
          "cache": {
            "type": "boolean",
            "default": true
          },
          "budgetMs": {
            "type": "integer",
            "minimum": 0,
            "default": 45000
          },
          "site": {
            "type": "string",
            "description": "Restrict every question to one domain."
          },
          "sites": {
            "type": "boolean",
            "default": true,
            "description": "Set false to ignore default/user site packs."
          },
          "deepIndex": {
            "type": "boolean",
            "description": "Use a deep local index built with aura-argus index --deep."
          }
        }
      },
      "BatchResponse": {
        "type": "object",
        "required": [
          "ok",
          "results"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          }
        }
      },
      "FetchRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "maxChars": {
            "type": "integer",
            "minimum": 100,
            "maximum": 200000,
            "default": 20000
          }
        }
      },
      "Passage": {
        "type": "object",
        "required": [
          "text",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable 12-character passage id derived from source URL, heading path and text."
          },
          "text": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "description": "prose, code, list, table, or heading."
          },
          "heading": {
            "type": "string"
          },
          "headingPath": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "description": "Heading slug suitable for a URL fragment; may be approximate for sites with custom heading ids."
          },
          "anchorType": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "heading-slug",
              null
            ]
          },
          "sourceId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "citation": {
            "type": "string",
            "description": "Source URL plus heading anchor when available."
          },
          "lineStart": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Start line in the extracted Markdown."
          },
          "lineEnd": {
            "type": [
              "integer",
              "null"
            ],
            "description": "End line in the extracted Markdown."
          }
        }
      },
      "Evidence": {
        "type": "object",
        "required": [
          "url",
          "passages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable 12-character source id derived from the final URL."
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "description": "registry, default, or user."
          },
          "entity": {
            "type": "string",
            "description": "Entity id when merged from a multi-entity search."
          },
          "depth": {
            "type": "integer",
            "description": "0 for a primary source, 1 for a followed link."
          },
          "via": {
            "type": "string",
            "description": "link or discovery when the source was not a primary registry source."
          },
          "version": {
            "type": "string",
            "description": "Document version when the source was rewritten to a versioned URL."
          },
          "updated": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last-Modified value of the fetched page, when provided by the server."
          },
          "passages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Passage"
            }
          }
        }
      },
      "Attempt": {
        "type": "object",
        "required": [
          "url",
          "ok"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "ms": {
            "type": "integer"
          },
          "passages": {
            "type": "integer"
          },
          "tries": {
            "type": "integer"
          },
          "status": {
            "type": "integer"
          },
          "cache": {
            "type": "string",
            "enum": [
              "memory",
              "page",
              "page-revalidated",
              "miss",
              "page-miss",
              "bypass"
            ]
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fallback": {
            "type": "boolean",
            "description": "True when this attempt used a fallback source."
          }
        }
      },
      "Fact": {
        "type": "object",
        "required": [
          "id",
          "type",
          "value",
          "citation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable 12-character fact id."
          },
          "type": {
            "type": "string",
            "enum": [
              "price",
              "percent",
              "version",
              "date",
              "limit",
              "status"
            ]
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "unit": {
            "type": "string"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "description": "Matched context excerpt."
          },
          "confidence": {
            "type": "number"
          },
          "passageId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "citation": {
            "type": "string"
          }
        }
      },
      "Consensus": {
        "type": "object",
        "required": [
          "sourceCount",
          "comparable",
          "agreementRatio",
          "agreements",
          "conflicts"
        ],
        "properties": {
          "sourceCount": {
            "type": "integer"
          },
          "comparable": {
            "type": "integer"
          },
          "agreementRatio": {
            "type": "number"
          },
          "agreements": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "required": [
          "schemaVersion",
          "question",
          "evidence",
          "attempts"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "schemaVersion": {
            "type": "integer"
          },
          "question": {
            "type": "string"
          },
          "entity": {
            "type": [
              "string",
              "null"
            ]
          },
          "entityOrigin": {
            "type": "string",
            "description": "registry, default, user, or a merged origin such as registry+default."
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Resolved document version, e.g. 20, 3.11, 8.0."
          },
          "versionRequested": {
            "type": "string",
            "description": "Explicit docVersion requested by the caller."
          },
          "mode": {
            "type": "string",
            "enum": [
              "registry",
              "web-fallback",
              "none",
              "error"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "facts": {
            "type": "array",
            "description": "Typed facts extracted from cited passages; deterministic and intent-filtered.",
            "items": {
              "$ref": "#/components/schemas/Fact"
            }
          },
          "consensus": {
            "description": "Cross-source agreement/conflict summary; omitted when fewer than two sources or no comparable facts.",
            "$ref": "#/components/schemas/Consensus"
          },
          "partial": {
            "type": "boolean",
            "description": "True when a wall-clock budget stopped retrieval before all planned sources."
          },
          "budget": {
            "type": "object",
            "properties": {
              "limitMs": {
                "type": "integer"
              },
              "usedMs": {
                "type": "integer"
              },
              "exhausted": {
                "type": "boolean"
              }
            }
          },
          "searchMode": {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "deep"
            ],
            "description": "Preset supplied by the caller."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "attempts": {
                "type": "integer"
              }
            }
          },
          "note": {
            "type": "string"
          },
          "tookMs": {
            "type": "integer"
          },
          "cached": {
            "type": "boolean"
          },
          "cache": {
            "type": "string",
            "enum": [
              "none",
              "result",
              "index"
            ]
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                },
                "confidence": {
                  "type": "object"
                },
                "facets": {
