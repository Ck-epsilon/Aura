{
  "name": "aura-argus",
  "version": "3.0.1",
  "description": "Agent-native retrieval layer: route questions to primary sources, return citable passages. No API key, no per-call billing.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "aura-argus": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./client": "./src/client.mjs",
    "./registry": "./src/registry.json",
    "./sites": "./src/sites.json"
  },
  "files": [
    "src",
    "adapters",
    "docs/integrations",
    "schema",
    "openapi.json",
    "README.md",
    "CONTRACT.md",
    "RESULTS.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "eval": "node eval/run.mjs",
    "bench": "node eval/bench.mjs",
    "answerability": "node eval/answerability.mjs",
    "gate": "node eval/gate.mjs",
    "bench:agent": "node eval/agent-bench.mjs",
    "verify": "node eval/verify-registry.mjs",
    "verify:registry": "node eval/verify-registry.mjs --registry-only",
    "verify-dsh": "node eval/verify-dsh.mjs",
    "warm": "node src/cli.mjs aura_argus_warm",
    "gaps": "node src/cli.mjs aura_argus_gaps",
    "index": "node src/cli.mjs aura_argus_index",
    "serve": "node src/cli.mjs aura_argus_serve",
    "mcp": "node src/cli.mjs aura_argus_mcp",
    "prepublishOnly": "npm test",
    "eval:heldout": "node eval/heldout.mjs",
    "bench:pk50": "node eval/pk50.mjs",
    "bench:pk215": "node eval/pk215.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "search",
    "retrieval",
    "agent",
    "mcp",
    "keyless",
    "rag"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ck-epsilon/Aura",
    "directory": "aura-argus"
  },
  "homepage": "https://github.com/Ck-epsilon/Aura/tree/main/aura-argus#readme",
  "bugs": {
    "url": "https://github.com/Ck-epsilon/Aura/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
