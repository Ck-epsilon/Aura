{
  "name": "aura-argus",
  "version": "0.1.0",
  "description": "Agent-native retrieval layer: route questions to primary sources, return citable passages. No API key, no per-call billing.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "aura-argus": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./registry": "./src/registry.json"
  },
  "files": [
    "src",
    "adapters",
    "docs/integrations",
    "schema",
    "openapi.json",
    "README.md",
    "RESULTS.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "eval": "node eval/run.mjs",
    "bench": "node eval/bench.mjs",
    "verify": "node eval/verify-registry.mjs",
    "verify-dsh": "node eval/verify-dsh.mjs",
    "serve": "node src/cli.mjs serve",
    "mcp": "node src/cli.mjs mcp",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["search", "retrieval", "agent", "mcp", "keyless", "rag"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ck-epsilon/Aura",
    "directory": "aura-argus"
  },
  "homepage": "https://github.com/Ck-epsilon/Aura/tree/main/aura-argus#readme",
  "bugs": {
    "url": "https://github.com/Ck-epsilon/Aura/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
